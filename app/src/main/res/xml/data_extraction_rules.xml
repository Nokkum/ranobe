<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for API 31+ (android:dataExtractionRules).
   The WebView data directory holds the WTR-LAB login session cookies, so keep it out of both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
