<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 30 and lower (android:fullBackupContent).
   The WebView data directory holds the WTR-LAB login session cookies, so keep it out of backups.
-->
<full-backup-content>
    <exclude domain="root" path="app_webview" />
</full-backup-content>
